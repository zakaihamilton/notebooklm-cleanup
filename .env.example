# Copy to .env and fill in one authentication option.

# Option 1: Interactive browser login (default)
# Leave all values empty and run `npm run cleanup`.
# A browser window opens so you can sign in manually on first run.
# Credentials are saved to credentials.json for later runs.

# Option 2: Auto-login with Google email/password (no 2FA)
# GOOGLE_EMAIL=your-email@gmail.com
# GOOGLE_PASSWORD=your-password
# GOOGLE_HEADLESS=false

# Option 3: Manual token/cookies from browser DevTools
# NOTEBOOKLM_AUTH_TOKEN=your-auth-token
# NOTEBOOKLM_COOKIES=your-cookie-header

# Optional
# NOTEBOOKLM_DEBUG=true
# FORCE_REAUTH=true
# CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# CHROME_DEBUG_PORT=9222
